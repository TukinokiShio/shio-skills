{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TukinokiShio/thunder-accounting/blob/master/skills/protocol/thunder-agent-proposal-v1.schema.json",
  "title": "Thunder Accounting Agent Proposal v1",
  "description": "A pending operation imported by the currently authenticated Thunder Accounting desktop session. Import is not confirmation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_id", "scope_token", "created_at", "kind", "items"],
  "properties": {
    "schema_version": { "const": "thunder-agent-proposal/v1" },
    "operation_id": { "type": "string", "format": "uuid" },
    "scope_token": { "type": "string", "format": "uuid" },
    "created_at": { "type": "string", "format": "date-time" },
    "kind": { "enum": ["expenses", "investments"] },
    "skill_name": {
      "description": "Optional on legacy v1 proposals. New Skills must set this to their directory name; it is display metadata, not source authentication.",
      "enum": ["thunder-expense-entry", "thunder-investment-snapshot"]
    },
    "skill_version": {
      "description": "Optional on legacy v1 proposals. New Skills must provide their semantic version; this is display metadata, not source authentication.",
      "type": "string",
      "maxLength": 32,
      "pattern": "^(0|[1-9][0-9]{0,2})[.](0|[1-9][0-9]{0,2})[.](0|[1-9][0-9]{0,2})(-[0-9A-Za-z.-]{1,20})?$"
    },
    "source_summary": {
      "description": "Optional on legacy v1 proposals. New Skills must provide a brief, non-sensitive summary of source type/date/row count, at most 500 characters. No IDs, phone numbers, credentials, local paths, or source text.",
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "investment_write_mode": {
      "description": "Optional. When authorized_auto_apply, the current account's app setting must also be enabled and the app revalidates session scope, declared Skill metadata, schema, and unchanged baseline before applying it. Skill metadata is self-declared, not process authentication.",
      "enum": ["authorized_auto_apply"]
    },
    "items": { "type": "array", "minItems": 1, "maxItems": 200 }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "expenses" } }, "required": ["kind"] },
      "then": { "properties": { "items": { "items": { "$ref": "#/$defs/expense" } } } }
    },
    {
      "if": { "properties": { "kind": { "const": "investments" } }, "required": ["kind"] },
      "then": { "properties": { "items": { "items": { "$ref": "#/$defs/holding" } } } }
    },
    {
      "if": { "properties": { "investment_write_mode": { "const": "authorized_auto_apply" } }, "required": ["investment_write_mode"] },
      "then": {
        "properties": {
          "kind": { "const": "investments" },
          "skill_name": { "const": "thunder-investment-snapshot" },
          "skill_version": { "enum": ["1.1.0", "1.2.0", "1.3.0"] }
        },
        "required": ["skill_name", "skill_version", "source_summary"]
      }
    }
  ],
  "$defs": {
    "decimalString": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]{0,35})(?:[.][0-9]{1,18})?$"
    },
    "expense": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "category1", "category2", "date", "note"],
      "properties": {
        "amount": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000000000, "multipleOf": 0.01 },
        "category1": { "type": "string", "minLength": 1, "maxLength": 120 },
        "category2": { "type": "string", "minLength": 1, "maxLength": 120 },
        "date": { "type": "string", "format": "date" },
        "note": { "type": "string", "maxLength": 1000 }
      }
    },
    "cashFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flow_id", "date", "kind", "amount", "currency", "included_in_market_value"],
      "properties": {
        "flow_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "date": { "type": "string", "format": "date" },
        "kind": { "enum": ["contribution", "withdrawal", "dividend", "fee"] },
        "amount": { "type": "string", "pattern": "^(?=.*[1-9])(?:0|[1-9][0-9]{0,35})(?:[.][0-9]{1,18})?$" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "included_in_market_value": {
          "description": "For dividends and fees, whether the flow's economic effect is reflected in the endpoint snapshot market value. Contributions and withdrawals remain external principal flows regardless of this flag.",
          "type": "boolean"
        }
      }
    },
    "holding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_key",
        "name",
        "asset_type",
        "quantity",
        "cost_basis",
        "market_value",
        "currency",
        "as_of",
        "source_note"
      ],
      "properties": {
        "asset_key": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "asset_type": { "type": "string", "minLength": 1, "maxLength": 40 },
        "quantity": { "$ref": "#/$defs/decimalString" },
        "cost_basis": { "oneOf": [{ "$ref": "#/$defs/decimalString" }, { "type": "null" }] },
        "market_value": { "oneOf": [{ "$ref": "#/$defs/decimalString" }, { "type": "null" }] },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "as_of": { "type": "string", "format": "date" },
        "source_note": { "type": "string", "maxLength": 1000 },
        "quantity_kind": {
          "description": "Optional only for backward-compatible legacy v1 proposals; new Skill proposals must emit it explicitly.",
          "enum": ["shares", "units", "currency_amount", "unknown"]
        },
        "cost_basis_kind": {
          "description": "Optional only for backward-compatible legacy v1 proposals; new Skill proposals must emit it explicitly.",
          "enum": ["total", "per_unit", "unknown"]
        },
        "cash_flows": {
          "description": "Optional only for backward-compatible legacy v1 proposals; absence means unknown, not zero flows.",
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/$defs/cashFlow" }
        },
        "cash_flows_complete": {
          "description": "Optional only for backward-compatible legacy v1 proposals; the app normalizes absence to false. Only true plus an empty cash_flows array means the source verified there were no flows.",
          "type": "boolean"
        }
      }
    }
  }
}
